#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
COMPILER="$ROOT/runes"
COMMAND=${1:-help}

usage() {
  cat <<'EOF'
Usage:
  ./runec check  [--prelude] FILE [FILE...]
  ./runec emit-c [--prelude] FILE [FILE...] [-o OUTPUT.c]
  ./runec build  [--prelude] FILE [FILE...] [-o PROGRAM] [-- CC_FLAGS...]
  ./runec run    [--prelude] FILE [FILE...] [-- PROGRAM_ARGS...]

Commands:
  check    Parse, resolve, and type-check without producing a binary.
  emit-c   Generate readable C. The default output is build/<name>.c.
  build    Generate C and compile it with the host C compiler.
  run      Build a temporary binary and run it.

Environment:
  CC       Host C compiler (default: gcc)
  CFLAGS   Additional C compiler flags
EOF
}

case "$COMMAND" in
  check|emit-c|build|run) shift ;;
  help|-h|--help) usage; exit 0 ;;
  *) printf 'runec: unknown command: %s\n\n' "$COMMAND" >&2; usage >&2; exit 2 ;;
esac

sources=()
tail_args=()
output=""
with_prelude=false
while (($#)); do
  case "$1" in
    --prelude) with_prelude=true; shift ;;
    -o|--output)
      (($# >= 2)) || { echo "runec: $1 requires a path" >&2; exit 2; }
      output=$2
      shift 2
      ;;
    --)
      shift
      tail_args=("$@")
      break
      ;;
    -*) echo "runec: unknown option: $1" >&2; exit 2 ;;
    *) sources+=("$1"); shift ;;
  esac
done

((${#sources[@]})) || { echo "runec: at least one .runes file is required" >&2; exit 2; }

if [[ ! -x "$COMPILER" ]] || find "$ROOT/src" -type f \( -name '*.c' -o -name '*.h' \) -newer "$COMPILER" -print -quit | grep -q .; then
  make -s -C "$ROOT" runes
fi

inputs=()
if $with_prelude; then
  inputs+=("$ROOT/src/std/prelude.runes")
fi
for source in "${sources[@]}"; do
  if [[ "$source" = /* ]]; then
    inputs+=("$source")
  else
    inputs+=("$PWD/$source")
  fi
done

if [[ "$COMMAND" == check ]]; then
  exec "$COMPILER" "${inputs[@]}"
fi

name=$(basename "${sources[0]}" .runes)
mkdir -p "$ROOT/build"

if [[ "$COMMAND" == emit-c ]]; then
  output=${output:-"$ROOT/build/$name.c"}
  mkdir -p "$(dirname "$output")"
  "$COMPILER" "${inputs[@]}" --emit-c "$output"
  printf '%s\n' "$output"
  exit 0
fi

cc=${CC:-gcc}
read -r -a env_cflags <<< "${CFLAGS:-}"

if [[ "$COMMAND" == build ]]; then
  output=${output:-"$ROOT/build/$name"}
  mkdir -p "$(dirname "$output")"
  c_file="$ROOT/build/$name.c"
  "$COMPILER" "${inputs[@]}" --emit-c "$c_file"
  "$cc" -std=c11 -O2 -Wall -Wextra "${env_cflags[@]}" "$c_file" \
    -lm "${tail_args[@]}" -o "$output"
  printf '%s\n' "$output"
  exit 0
fi

temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/runec.XXXXXX")
trap 'rm -rf "$temp_dir"' EXIT
c_file="$temp_dir/$name.c"
binary="$temp_dir/$name"
"$COMPILER" "${inputs[@]}" --emit-c "$c_file"
"$cc" -std=c11 -O2 -Wall -Wextra "${env_cflags[@]}" "$c_file" -lm \
  -o "$binary"
"$binary" "${tail_args[@]}"
