id = "runes"
name = "Runes"
version = "0.1.3"
schema_version = 1
authors = ["Runes contributors"]
description = "Runes language syntax highlighting"
repository = "https://github.com/Raulgooo/runes-programming-language"
themes = []
icon_themes = []
languages = ["languages/runes"]
capabilities = []

[grammars.runes]
repository = "@GRAMMAR_REPOSITORY@"
rev = "@GRAMMAR_REV@"

[language_servers.runes-lsp]
name = "Runes Language Server"
languages = ["Runes"]

[context_servers]

[agent_servers]

[slash_commands]
