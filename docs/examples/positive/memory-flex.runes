-- EXPECT OUTPUT: 10 20 30
type Cell = { value: i32 }

-- The same alloc() expression follows the active owning caller:
--   dynamic caller       -> raw allocation
--   regional caller      -> caller's arena
--   GC caller            -> traced GC allocation
-- A stack specialization is rejected because stack code cannot own alloc()
-- storage.
flex f make_cell(value: i32) = result: *Cell {
    unsafe {
        result = alloc(sizeof(Cell)) as *Cell
        result.value = value
    }
}

dynamic f flex_from_dynamic() = result: i32 {
    *Cell cell = make_cell(10)
    unsafe {
        result = cell.value
        raw_free(cell as *void)
    }
}

regional f flex_from_regional() = result: i32 {
    *Cell cell = make_cell(20)
    unsafe { result = cell.value }
    -- The regional caller owns cleanup.
}

gc f flex_from_gc() = result: i32 {
    *Cell cell = make_cell(30)
    runes_gc_collect()
    unsafe { result = cell.value }
    -- The collector owns cleanup.
}

f main() {
    print(flex_from_dynamic(), " ", flex_from_regional(), " ",
          flex_from_gc())
}
