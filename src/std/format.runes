pub flex f write_integer_to<W: Writer>(
    writer: *W,
    cursor: IntegerCursor
) = outcome: Result<usize, FormatError> {
    usize total = 0
    bool failed = false
    while !cursor.is_done() and !failed {
        [32]u8 chunk = []
        usize count = 0
        unsafe {
            while count < 32 and !cursor.is_done() {
                match (&cursor).next() {
                    Some(byte) -> {
                        chunk[count] = byte
                        count = count + 1
                    }
                    None -> {}
                }
            }
            match write_all_to<W>(
                writer,
                const_slice(&chunk, count)
            ) {
                Ok(written) -> {
                    total = total + written
                }
                Err(failure) -> {
                    failed = true
                    outcome = Result.Err<usize, FormatError>(
                        FormatError.Writer(failure)
                    )
                }
            }
        }
    }
    if !failed {
        outcome = Result.Ok<usize, FormatError>(total)
    }
}

pub flex f write_text_to<W: Writer>(
    writer: *W,
    cursor: TextCursor
) = outcome: Result<usize, FormatError> {
    usize total = 0
    bool failed = false
    unsafe {
        while !cursor.is_done() and !failed {
            match (&cursor).next() {
                Some(value) -> {
                    [4]u8 encoded = [0, 0, 0, 0]
                    usize encoded_length = 0
                    runes_utf8_encode(
                        value,
                        &encoded,
                        &encoded_length
                    )
                    match write_all_to<W>(
                        writer,
                        const_slice(&encoded, encoded_length)
                    ) {
                        Ok(written) -> {
                            total = total + written
                        }
                        Err(failure) -> {
                            failed = true
                            outcome = Result.Err<usize, FormatError>(
                                FormatError.Writer(failure)
                            )
                        }
                    }
                }
                None -> {}
            }
        }
    }
    if !failed {
        outcome = Result.Ok<usize, FormatError>(total)
    }
}

pub flex f write_u64_to<W: Writer>(
