pub type Option<T> =
    | None
    | Some(T)


pub error UnwrapError = {
    | NoValueError
}

-- Current methods copy full data, performance wise it would be better to just carry a reference,
-- System ergonomy not fully ready to allow me to safely point to og data for this. I'll fix it later
pub method Option<T> {
    f is_some(self) = result: bool {
        result = match self {
            Some(_) -> true,
            None -> false,
        }
    }

    f is_none(self) = result: bool {
        result = match self {
            Some(_) -> false,
            None -> true,
        }
    }

    f unwrap_or(self, fallback: T) = result: T {
        result = match self {
            Some(value) -> value,
            None -> fallback,
        }
    }

    f unwrap(self) = result: !T {
        match self {
            Some(value) -> {
                result = value
            }
            None -> {
                result = error.UnwrapError.NoValueError
            }
        }
    }

    f map<U>(self, transform: f(T) -> U) = result: Option<U> {
        result = match self {
            Some(value) -> Option.Some<U>(transform(value)),
            None -> Option.None<U>(),
        }
    }
}

pub type Result<T, E> =
    | Ok(T)
    | Err(E)

-- Result methods are allocation-free and currently operate by value. A large
-- T or E can therefore be copied when the result, receiver, or payload moves.
pub method Result<T, E> {
    f is_ok(self) = result: bool {
        result = match self {
            Ok(_) -> true,
            Err(_) -> false,
        }
    }

    f is_err(self) = result: bool {
        result = match self {
            Ok(_) -> false,
            Err(_) -> true,
        }
    }

    f unwrap_or(self, fallback: T) = result: T {
        result = match self {
            Ok(value) -> value,
            Err(_) -> fallback,
        }
    }

    f map<U>(self, transform: f(T) -> U) = result: Result<U, E> {
        result = match self {
            Ok(value) -> Result.Ok<U, E>(transform(value)),
            Err(failure) -> Result.Err<U, E>(failure),
        }
    }

    f map_error<F>(self, transform: f(E) -> F) = result: Result<T, F> {
        result = match self {
            Ok(value) -> Result.Ok<T, F>(value),
            Err(failure) -> Result.Err<T, F>(transform(failure)),
        }
    }

    f and_then<U>(
        self,
        transform: f(T) -> Result<U, E>
    ) = result: Result<U, E> {
        result = match self {
            Ok(value) -> transform(value),
            Err(failure) -> Result.Err<U, E>(failure),
        }
    }
}

-- Portable error identities. Platform backends translate their native error
-- codes into these types instead of exposing errno or syscall details.
pub type IoError =
    | EndOfInput
    | Interrupted
    | PermissionDenied
    | NotFound
    | BrokenPipe
    | InvalidInput
    | Unknown

pub type ParseError =
    | InvalidSyntax(usize)
    | UnexpectedEnd(usize)
    | OutOfRange(usize)

pub type AllocationError =
    | OutOfMemory
    | CapacityOverflow
