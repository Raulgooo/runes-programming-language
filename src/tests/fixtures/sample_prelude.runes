-- External contracts shared by the broad language showcase samples.

extern f tick()
extern f is_done() = result: bool
f done() = result: bool result = is_done()

extern f raw_alloc(size: usize) = result: *void
extern f raw_free(ptr: *void)
extern f memset(ptr: *void, value: i32, size: usize) = result: *void
extern f memcpy(dst: *void, src: *void, len: usize) = result: *void
extern f alloc(size: usize) = result: *void
extern f collect_errors(source: str) = result: *Error
extern f sqrt(value: f32) = result: f32

extern u64 heap_cursor
extern f bump_alloc(size: usize) = result: *void
extern f preempt_current()

mod kernel {
    mod arch {
        mod x86 {
            pub f read_cr3() = result: u64 { result = 0 }
            pub f read_cr2() = result: u64 { result = 0 }
        }
    }
}

extern f log_error(error_code: u32)
extern f panic(message: str)
extern f map_page(vaddr: u64, paddr: u64, flags: u64) = result: !void
extern f render_point(x: f32, y: f32)
extern f render_rect(x: f32, y: f32, width: f32, height: f32)
extern f dispatch(number: u64, a: u64, b: u64, c: u64) = result: u64
extern f init_output(table: *void)
type Keyboard = { id: u8 }
extern Keyboard keyboard
extern f keyboard_push(scancode: u8)
method Keyboard {
    f push(self, scancode: u8) { keyboard_push(scancode) }
}
extern f read_file(path: str) = result: !str

extern f parse_config(source: str) = result: *Config
extern f build_ast(source: str) = result: *Node
extern f eval(node: *Node) = result: !i32
extern f config_load(source: str) = result: *Config
extern f ruleset_from_config(config: *Config) = result: *RuleSet
extern f apply_rules(rules: *RuleSet)
extern f make_pair(a: i32, b: i32) = result: (*Node, *Node)
extern f get_coords() = result: (i32, i32, i32)
extern f framebuffer_resize(width: u32, height: u32)

type Config = { id: i32 }
type Node = { val: i32, next: *Node }
type Error = { code: i32 }
type RuleSet = { id: i32 }
