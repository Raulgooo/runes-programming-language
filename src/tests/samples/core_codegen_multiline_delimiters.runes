type Pair = {
    first: i32
    second: i32
}

f add(
    left: i32,
    right: i32,
) = result: i32 {
    result = left + right
}

f main() {
    Pair pair = Pair(
        first: 40,
        second: 2,
    )
    [3]i32 values = [
        10,
        20,
        12,
    ]
    (i32, i32) tuple = (
        pair.first,
        pair.second,
    )
    i32 first, i32 second = tuple
    i32 grouped = (
        values[0]
        + values[1]
        + values[2]
    )
    i32 continued = 40 +
        2

    print(
        add(first, second),
        grouped,
        continued,
    )
}
