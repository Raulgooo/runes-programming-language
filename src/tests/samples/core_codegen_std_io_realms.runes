use std.io.BufferedReader
use std.io.SliceReader
use std.io.read_line_from

flex f line_case() = result: bool {
    [6]u8 source_storage = [0x68, 0xc3, 0xa9, 0x79, 0x0a, 0x78]
    []const u8 source = source_storage
    reader := SliceReader.new(source)
    [2]u8 buffer_storage = []
    []u8 buffer = buffer_storage
    buffered := BufferedReader<SliceReader>.new(&reader, buffer)
    [8]u8 output_storage = []
    []u8 output = output_storage
    match read_line_from<BufferedReader<SliceReader>>(&buffered, output) {
        Ok(value) -> { result = value == "héy" }
        Err(_) -> { result = false }
    }
}

dynamic f dynamic_case() = result: bool {
    result = line_case()
}

regional f regional_case() = result: bool {
    result = line_case()
}

gc f gc_case() = result: bool {
    result = line_case()
}

dynamic f main() {
    print(dynamic_case(), " ", regional_case(), " ", gc_case())
}
