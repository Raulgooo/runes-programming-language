-- Fixed arrays and raw pointers are core bootstrap features.
f core_arrays_pointers() = result: i32 {
    [4]i32 values = [1, 2, 3, 4]
    *i32 first = &values
    unsafe {
        first[1] = 7
        *(first + 2) = 9
    }
    result = values[0] + values[1] + values[2] + values[3]
}

f main() {
    core_arrays_pointers()
}
