extern f runes_str_is_utf8(value: str) = result: bool
extern f runes_str_decode_next(
    value: str,
    index: *usize,
    scalar: *char
) = result: bool
extern f runes_utf8_encode(
    scalar: char,
    output: *u8,
    length: *usize
) = result: bool
extern f runes_str_hash(value: str) = result: u64

f main() {
    str value = "é界"
    usize index = 0
    char scalar = '\0'
    bool valid = runes_str_is_utf8(value)
    bool decoded = runes_str_decode_next(value, &index, &scalar)

    [4]u8 encoded = []
    usize encoded_len = 0
    bool encoded_ok = runes_utf8_encode('界', &encoded, &encoded_len)

    print(valid, " ", decoded, " ", scalar, " ", index, " ",
          encoded_ok, " ", encoded_len, " ", runes_str_hash(value))
}
