error MathError = {
    | DivisionByZero
    | ZeroNotAllowed
}

f divide(a: i32, b: i32) = result: !i32 {
    if b == 0 {
        result = error.MathError.DivisionByZero
    } else {
        result = a / b
    }
}

f doubled_quotient(a: i32, b: i32) = result: !i32 {
    i32 quotient = try divide(a, b)
    result = quotient * 2
}

f require_nonzero(value: i32) = result: !void {
    if value == 0 {
        result = error.MathError.ZeroNotAllowed
        return
    }
}

f checked_value(value: i32) = result: !i32 {
    try require_nonzero(value)
    result = value
}

f report_failure() {
    i32 value = divide(1, 0) catch |err| {
        print("error ", err)
        return
    }
    print(value)
}

f matched_quotient(a: i32, b: i32) = result: i32 {
    result = match divide(a, b) {
        Ok(value) -> value,
        Err(_) -> -2,
    }
}

f main() {
    i32 success = doubled_quotient(20, 4) catch -1
    i32 failure = doubled_quotient(20, 0) catch -1
    i32 void_failure = checked_value(0) catch -1
    print(success, " ", failure, " ", void_failure)
    report_failure()
    print(matched_quotient(9, 3), " ", matched_quotient(9, 0))
}
