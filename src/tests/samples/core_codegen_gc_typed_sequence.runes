extern f alloc(size: usize) = result: *void
extern f runes_gc_collect()
extern f runes_gc_debug_object_count() = result: usize

type Node = { value: i32 }
type NodeRef = { node: ?*Node }

gc f make_refs() = result: *NodeRef {
    unsafe {
        result = alloc(2 * sizeof(NodeRef)) as *NodeRef
        result[0].node = null
        result[1].node = alloc(sizeof(Node)) as *Node
        unwrap(result[1].node).value = 42
        runes_gc_collect()
    }
}

f main() {
    *NodeRef refs = make_refs()
    runes_gc_collect()
    unsafe {
        print(unwrap(refs[1].node).value, " ",
              runes_gc_debug_object_count())
    }
}
