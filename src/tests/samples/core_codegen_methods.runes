type Counter = {
    value: i32,
}

method Counter {
    f add(self: *Counter, amount: i32) {
        self.value = self.value + amount
    }

    f get(self) = result: i32 {
        result = self.value
    }
}

f main() {
    Counter counter = Counter(value: 10)
    counter.add(5)
    *Counter pointer = &counter
    pointer.add(2)
    print(counter.get(), pointer.get())
}
